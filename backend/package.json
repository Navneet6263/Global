{
  "name": "@sapling-global/verification-api",
  "version": "0.1.0",
  "private": true,
  "description": "Sapling Global multi-tenant verification platform API",
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "node scripts/clean-build.mjs",
    "build": "nest build",
    "start": "node dist/main.js",
    "prestart:e2e": "node scripts/clean-build.mjs",
    "start:e2e": "nest start",
    "prestart:dev": "node scripts/clean-build.mjs",
    "start:dev": "nest start --watch",
    "predev": "node scripts/clean-build.mjs",
    "dev": "nest start --watch",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\" prisma.config.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "tsx --test test/**/*.test.ts",
    "test:build": "node --test scripts/clean-build.test.mjs",
    "test:integration": "tsx --test test/**/*.integration.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:preflight": "tsx prisma/preflight.ts",
    "prisma:verify": "tsx prisma/verify-deployment.ts",
    "prisma:rotate-data-key": "tsx prisma/rotate-data-key.ts",
    "prisma:e2e-fixture": "tsx prisma/e2e-fixture.ts",
    "prisma:dashboard-users": "tsx prisma/provision-dashboard-users.ts",
    "prisma:golden-cleanup": "tsx prisma/golden-flow-cleanup.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "^12.33.0",
    "@fastify/compress": "^8.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-mssql": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.0.0",
    "mssql": "^12.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "regenerator-runtime": "^0.14.1",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.7.0",
    "prisma": "^7.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
