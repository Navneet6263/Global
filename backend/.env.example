NODE_ENV=development
PORT=4000
LOG_LEVEL=info
PROCESS_ROLE=all
WEB_ORIGIN=http://localhost:8080
# Leave blank when /api/v1 is reverse-proxied on WEB_ORIGIN. Set this only
# when the browser intentionally uses a separate public API origin.
PUBLIC_API_ORIGIN=
# false for direct access, or an explicit trusted hop count/CIDR list behind ingress.
TRUST_PROXY=false

# SQL Server runtime identity — give this user data access only, never db_owner.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Sapling Global
DB_USER=sapling_global_app
DB_PASSWORD=replace-with-a-strong-password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=30000
DB_REQUEST_TIMEOUT_MS=30000
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=30000

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-dedicated-32-character-data-key
DATA_ENCRYPTION_KEY_VERSION=1
# Keep retired versions only while rows/outbox payloads are being re-encrypted.
DATA_ENCRYPTION_PREVIOUS_KEYS={}
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Passwords older than this must be changed at the next sign-in (0 = off).
PASSWORD_MAX_AGE_DAYS=90
COOKIE_SECURE=false

# Local disk is development-only. Production uses private object storage + signed URLs.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_BUCKET=sapling-global-private
OBJECT_STORAGE_PATH=.data/objects
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
UPLOAD_MAX_BYTES=10485760
# Per API process; choose alongside file-size limit and available memory.
UPLOAD_CONCURRENCY=4
UPLOAD_PER_ACTOR_CONCURRENCY=2
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_HEALTH_URL=
NOTIFICATION_WEBHOOK_SECRET=replace-with-an-independent-32-character-secret
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
RETENTION_WORKER_ENABLED=true
RETENTION_POLL_INTERVAL_MS=86400000
# Released report download access and manager renewals; integer days, 1–3650.
# Expiry controls access only. Immutable report files follow the retention policy.
REPORT_DOWNLOAD_TTL_DAYS=30
IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false

# Required only when bootstrapping the first production administrator.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Platform Administrator
# Supply this externally at seed time; never store a usable bootstrap password here.
SEED_ADMIN_PASSWORD=
SEED_RESET_ADMIN_PASSWORD=false
SEED_TENANT_CODE=

# Company SMTP for email: sign-up codes, consent OTP, candidate links, onboarding updates.
# Leave SMTP_HOST empty in development: sign-up codes are then printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sapling Global <no-reply@example.com>

# Public company sign-up (new company admin lands in Onboarding until Operations approves).
SELF_SIGNUP_ENABLED=true
SELF_SIGNUP_TENANT_CODE=SAPLING

# Platform Admin can view everything and escalate cases, but not change data.
PLATFORM_ADMIN_VIEW_ONLY=true

# Field Executive physical visits. Off until field work launches: an Address check then
# does not wait for a physical visit before QA. Set to true to require it again.
FIELD_WORK_ENABLED=false
