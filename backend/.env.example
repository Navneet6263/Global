NODE_ENV=development
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# SQL Server runtime identity — give this user data access only, never db_owner.
DATABASE_URL="sqlserver://localhost:1433;database=Sapling Global;user=sapling_global_app;password=replace-with-a-strong-password;encrypt=true;trustServerCertificate=true"
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Sapling Global
DB_USER=sapling_global_app
DB_PASSWORD=replace-with-a-strong-password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=30000
DB_REQUEST_TIMEOUT_MS=30000
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=30000

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-dedicated-32-character-data-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# Local disk is development-only. Production uses private object storage + signed URLs.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_BUCKET=sapling-global-private
OBJECT_STORAGE_PATH=.data/objects
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
AZURE_STORAGE_CONNECTION_STRING=
UPLOAD_MAX_BYTES=10485760
NOTIFICATION_WEBHOOK_URL=
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
RETENTION_WORKER_ENABLED=true
RETENTION_POLL_INTERVAL_MS=86400000
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false

# Required only when bootstrapping the first production administrator.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Platform Administrator
SEED_ADMIN_PASSWORD=replace-with-at-least-14-random-characters
SEED_RESET_ADMIN_PASSWORD=false
SEED_TENANT_CODE=
